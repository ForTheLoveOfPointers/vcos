BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

BR2_TARGET_GENERIC_HOSTNAME="vcos"
BR2_TARGET_GENERIC_ISSUE="VCOS virtual console"
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_VCOS_PATH)/board/qemu-x86_64/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_VCOS_PATH)/board/qemu-x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_VCOS_PATH)/board/qemu-x86_64/post-image.sh"

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_VCOS_PATH)/board/qemu-x86_64/linux.fragment"

BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_VCOS_PATH)/board/qemu-x86_64/busybox.fragment"
BR2_PACKAGE_VCOS_RUNTIME=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_VCOS_GUEST=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y

BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_LABEL="VCOSROOT"
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_REPRODUCIBLE=y

BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y

BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_VCOS_MODULES=y
BR2_PACKAGE_VCOS_MODULE_HOST=y
BR2_PACKAGE_VCOS_MODMAN=y
